# =============================================================================
# Eidolon Channel — secrets & env knobs (local dev)
# =============================================================================
# Copy to config/.env (or run: ./deploy/dev/init.sh)
#
# Worker loads this file via EIDOLON_CHANNEL_ENV_FILE (alias: EIDOLON_CHANNEL_LIVEKIT_ENV).
# Structured fields (host/port/providers): config/settings.yaml — secret placeholders = env var names.
#
# Naming convention:
#   <PROVIDER>_<STAGE>_<FIELD>   plugin-specific config
#   <STAGE>_PROVIDER             selects active provider
#   LIVEKIT_* / AGENT_*          platform / agent identity
#
# Shell environment variables override values from this file.
# =============================================================================

# ---------- LiveKit Server ----------
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=LIVEKIT_API_KEY
LIVEKIT_API_SECRET=LIVEKIT_API_SECRET

# ---------- Agent ----------
# AGENT_MODE: streaming (VAD -> STT -> LLM -> TTS with interruption) | batch
AGENT_MODE=streaming
AGENT_HOST=0.0.0.0
AGENT_PORT=8766
AGENT_INSTRUCTIONS=You are a helpful, friendly voice assistant. Keep responses concise.
# AGENT_WELCOME_MESSAGE: 进房欢迎语，留空则静默等待用户先说话
AGENT_WELCOME_MESSAGE=你好！我是你的 AI 助手，请问有什么可以帮你的？
# AGENT_FALSE_INTERRUPTION_TIMEOUT: 误打断恢复超时(秒)，中文 STT 延迟高建议 ≥6；设 none 禁用
AGENT_FALSE_INTERRUPTION_TIMEOUT=6.0
# AGENT_AUDIO_SAMPLE_RATE: 全链路音频采样率(Hz)，与 TTS 原生输出对齐可消除重采样开销
AGENT_AUDIO_SAMPLE_RATE=16000
# AGENT_STT_COMMIT_TIMEOUT: framework `commit_user_turn(transcript_timeout=...)`
#   等待 STT FINAL 的窗口（秒）。framework 默认 2.0s 对中文长句太短，超时后会
#   把 INTERIM 强制晋级 FINAL → 触发一次会被 cancel 的 LLM 调用。
AGENT_STT_COMMIT_TIMEOUT=5.0
# AEC warmup：欢迎语开播头 N 秒压制用户音频（=同时压制 STT）。
# 0 / none = 全程可打断；0.5-1.0 = 主流；≈ welcome 时长 = 欢迎语全程不可打断
AGENT_AEC_WARMUP_DURATION=1.0

# ---------- Stage provider selection ----------
# STT_PROVIDER:  bailian | sensetime
# TTS_PROVIDER:  sensetime | bailian
# VAD_PROVIDER:  firered_pvad | firered | silero | none
STT_PROVIDER=sensetime
TTS_PROVIDER=sensetime
VAD_PROVIDER=firered

# ---------- LLM (OpenAI-compatible client) ----------
OPENAI_LLM_BASE_URL=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_LLM_API_KEY=OPENAI_LLM_API_KEY
# 留空 → 使用 framework / OpenAI plugin 默认值
# OPENAI_LLM_TEMPERATURE=0.7
# OPENAI_LLM_TIMEOUT=120
# OPENAI_LLM_MAX_TOKENS=100000

# ---------- Eidolon companion-brain (gRPC, optional) ----------
# REMOTE_AGENT_RPC_TARGET 非空时切到 gRPC ``EidolonAgent.Chat``，旁路上面的
# OpenAI 兼容 LLM。两者二选一。
#
# 契约 (.proto):    eidolon/proto/eidolon/livekit/agent/eidolon_agent_rpc/v1/grpc_gen/eidolon.proto
#                   (与 eidolon_agent 仓库的 eidolon.proto 镜像)
# 重生 Python 桩：  仓库根执行 ./scripts/gen_eidolon_agent_rpc.sh
# Device token：    ./scripts/provision_eidolon_token.py 取号（需先起 eidolon_agent
#                   admin HTTP + gRPC，且配对成功一次。Token 默认 30 天有效）
#
# Target 两种形式（取一）：
#   TCP   127.0.0.1:45051
#         eidolon_agent dev 默认端口；调试 / 跨机部署用这种。
#   UDS   unix:///Users/<your-user>/eidolon/run/eidolon-agent.sock
#         同机部署时省 ~10-30μs / round-trip（gRPC 直接走 syscall，旁路 TCP/IP 栈）。
#         前提：channel worker 与 eidolon_agent 必须由同一 user 跑（socket
#         文件 0600 权限），且路径必须是绝对路径（gRPC client 不展开 ~）。
#         eidolon_agent 默认开 UDS 在 ~/eidolon/run/eidolon-agent.sock（见它的
#         config/config.yaml: grpc.uds_path）。
# DEVICE_TOKEN 留空 → EidolonAgentGrpcLlm 构造时 raise ValueError（启动即失败）。
# CONVERSATION_ID_PREFIX 与 LiveKit room.name 拼成 conversation_id 给 brain（默认 "livekit"）。
# REMOTE_AGENT_RPC_TARGET=
# REMOTE_AGENT_RPC_DEVICE_TOKEN=<JWT from scripts/provision_eidolon_token.py>
# REMOTE_AGENT_RPC_CONVERSATION_ID_PREFIX=livekit

# ---------- STT — SenseTime SenseAudio ----------
SENSETIME_STT_API_URL=wss://api.senseaudio.cn/ws/v1/audio/transcriptions
SENSETIME_STT_API_KEY=SENSETIME_STT_API_KEY
SENSETIME_STT_MODEL=senseaudio-asr-deepthink-1.5-260319
SENSETIME_STT_SAMPLE_RATE=16000
SENSETIME_STT_LANGUAGE=zh
# 流式断线重连次数；语音端点检测：最短发声 / 最短静默
SENSETIME_STT_MAX_STREAM_RETRIES=3
SENSETIME_STT_MIN_SPEECH_DURATION_MS=300
SENSETIME_STT_SILENCE_DURATION_MS=800

# ---------- STT — Bailian FunASR (only used when STT_PROVIDER=bailian) ----------
BAILIAN_STT_API_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
BAILIAN_STT_API_KEY=BAILIAN_STT_API_KEY
BAILIAN_STT_SAMPLE_RATE=16000
BAILIAN_STT_LANGUAGE=zh
# ITN: inverse-text-normalization，开启后把识别出的阿拉伯数字归一化（"12" → "十二"）
BAILIAN_STT_ITN=true

# G16 STT VAD gate (cost optimization, default off)
BAILIAN_STT_GATE_ENABLED=false
BAILIAN_STT_GATE_PREROLL_MS=500
BAILIAN_STT_GATE_TAIL_MS=1500
BAILIAN_STT_GATE_KEEPALIVE_INTERVAL_SEC=1.0
BAILIAN_STT_GATE_KEEPALIVE_FRAME_MS=100
BAILIAN_STT_GATE_VAD_HIGH=0.6
BAILIAN_STT_GATE_VAD_LOW=0.3
BAILIAN_STT_GATE_RMS=500

# ---------- STT transcript gate (G23, provider-agnostic) ----------
# 防御 framework audio_recognition 把跨 user-turn 的 INTERIM / FINAL 拼到上一句的 bug。
# 默认关闭，真机回归验证后再开。
EIDOLON_STT_TRANSCRIPT_GATE_ENABLED=false
EIDOLON_STT_GATE_SUPPRESS_WINDOW_MS=200

# ---------- TTS — SenseTime SenseAudio ----------
# Docs: https://senseaudio.cn/docs/tts_api_internal
SENSETIME_TTS_API_URL=wss://api.senseaudio.cn/ws/v1/t2a_v2
SENSETIME_TTS_API_KEY=SENSETIME_TTS_API_KEY
SENSETIME_TTS_MODEL=senseaudio-tts-1.5-260319
SENSETIME_TTS_VOICE=female_0033_a
SENSETIME_TTS_SAMPLE_RATE=32000
SENSETIME_TTS_SPEED=1.0
SENSETIME_TTS_VOL=1.0
SENSETIME_TTS_PITCH=0
# 预热的 WebSocket 连接池大小；首 token 超时（秒）
SENSETIME_TTS_POOL_SIZE=4
SENSETIME_TTS_FIRST_TOKEN_TIMEOUT=15.0

# ---------- TTS — Bailian CosyVoice (only used when TTS_PROVIDER=bailian) ----------
BAILIAN_TTS_API_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
BAILIAN_TTS_API_KEY=BAILIAN_TTS_API_KEY
BAILIAN_TTS_MODEL=cosyvoice-v3-flash
BAILIAN_TTS_VOICE=longanyang
BAILIAN_TTS_AUDIO_FORMAT=pcm
BAILIAN_TTS_SAMPLE_RATE=16000
BAILIAN_TTS_SPEECH_RATE=1.0
BAILIAN_TTS_VOLUME=50
BAILIAN_TTS_PITCH=1.0
BAILIAN_TTS_POOL_SIZE=8
# 启动时同步开多少条 WS（剩下的后台慢慢补到 POOL_SIZE）。让冷启动更快。
BAILIAN_TTS_POOL_SIZE_BOOTSTRAP=3
BAILIAN_TTS_POOL_REFILL_BACKOFF=1.5
BAILIAN_TTS_POOL_ACQUIRE_TIMEOUT=12.0
# acquire-time staleness eviction. dashscope 服务端 ~30s 空闲超时，设 25s 留余量。
BAILIAN_TTS_POOL_MAX_IDLE_SEC=15.0
# WS-level keepalive；0 禁用（不建议）
BAILIAN_TTS_WS_HEARTBEAT_SEC=15.0
BAILIAN_TTS_TASK_STARTED_TIMEOUT=15.0
BAILIAN_TTS_TASK_FINISHED_TIMEOUT=20.0
BAILIAN_TTS_FIRST_TOKEN_TIMEOUT=15.0
BAILIAN_TTS_NO_FIRST_AUDIO_TIMEOUT=5.0
# Sentence aggregator：把 LLM 流式 token 聚合成句子再送 TTS，控制首句延迟与节奏
#   SOFT_MIN_CHARS: 达到该字符数即可在标点处 flush（越小首句越快，但碎片多）
#   HARD_MAX_CHARS: 强制 flush 的上限（避免长句一次性合成造成卡顿）
#   IDLE_MS:        空闲多少毫秒后即使未到 SOFT_MIN 也 flush
BAILIAN_TTS_AGGREGATOR_SOFT_MIN_CHARS=12
BAILIAN_TTS_AGGREGATOR_HARD_MAX_CHARS=80
BAILIAN_TTS_AGGREGATOR_IDLE_MS=300
# 第一句激进 flush（默认关闭）。LLM 又快又 burst 时打开。
# SOFT_MIN_CHARS=0 沿用默认；FLUSH_ANY_PUNCT=true 第一句任何标点都 flush。
BAILIAN_TTS_AGGREGATOR_FIRST_SENTENCE_SOFT_MIN_CHARS=0
BAILIAN_TTS_AGGREGATOR_FIRST_SENTENCE_FLUSH_ANY_PUNCT=false
# 开启 TTS 音频帧诊断日志（调试音质/丢帧时打开）
BAILIAN_TTS_LOG_AUDIO_DIAG=true

# ---------- 流畅打断 / Interrupt 调参 (G17-G22) ----------
# 主控旋钮：决策预算（毫秒）。VAD 起触发 mute 后最长 N ms 内必须决策。
#   500ms (默认): 对齐 OpenAI Realtime / LiveKit Adaptive 顶级体验。
# 超时：VAD 仍在 → trust VAD，cancel；VAD 已止 → unduck (丢弃陈旧 buffer)。
EIDOLON_INTERRUPT_DECISION_MS=500
# 首条 STT INTERIM 触发 cancel 的最少字符数（去标点后），过滤单字噪音/咳嗽。
EIDOLON_INTERRUPT_MIN_INTERIM_CHARS=2
#
# 以下为 fallback / legacy 调参，绝大多数生产部署无需改动。
#
# (legacy alias) EIDOLON_DUCK_SUSPEND_TIMEOUT_SEC：仅在 EIDOLON_INTERRUPT_DECISION_MS
# 未设置时生效，作为旧名义兼容。新部署只用 _MS 版本。
# EIDOLON_DUCK_SUSPEND_TIMEOUT_SEC=0.5
#
# (deprecated, G18c) VAD 置信度门限：G18c 已将 MinSpeakingDurationPolicy 的
# 置信度短路逻辑删除，此 env 现在为 no-op，仅保留以防紧急回退。
# EIDOLON_EOT_MIN_VAD_CONFIDENCE=0.0
#
# (fallback) EOT 评分门限：仅在 G18a 首信号路径无法触发（极少）时作为后备路径
# 使用。InterruptDecider.on_stt_interim 内部的 cancel/resume 阈值，可调但不建议。
# EIDOLON_EOT_DUCK_EARLY_CANCEL_SCORE=0.7
# EIDOLON_EOT_DUCK_EARLY_RESUME_SCORE=0.2

# ---------- Optional: 模型路径覆盖（留空使用插件自带 bundled 模型） ----------
# EIDOLON_EOT_MODEL_DIR=
# EIDOLON_FIRERED_PVAD_MODEL_DIR=
# EIDOLON_EOT_DEBUG_LOG: 非空时输出 NDJSON 调试日志到该路径
# EIDOLON_EOT_DEBUG_LOG=
