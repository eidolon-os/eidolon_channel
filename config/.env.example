# =============================================================================
# Eidolon Channel — SECRETS ONLY (local dev)
# =============================================================================
# Copy to config/.env (or run: ./deploy/dev/init.sh) and fill in real values.
# All NON-secret config lives in config/settings.yaml — only API keys / tokens
# belong here. Shell env vars override these.
# =============================================================================

# ---------- LiveKit Server ----------
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# ---------- LLM (OpenAI-compatible) ----------
OPENAI_LLM_API_KEY=your-openai-llm-api-key

# ---------- Eidolon companion-brain (gRPC) device token ----------
# Obtain via ./scripts/provision_eidolon_token.py (30-day validity).
REMOTE_AGENT_RPC_DEVICE_TOKEN=your-device-token

# ---------- STT / TTS provider API keys ----------
# Bailian also accepts DASHSCOPE_API_KEY as a fallback.
SENSETIME_STT_API_KEY=your-sensetime-stt-api-key
SENSETIME_TTS_API_KEY=your-sensetime-tts-api-key
BAILIAN_STT_API_KEY=your-bailian-stt-api-key
BAILIAN_TTS_API_KEY=your-bailian-tts-api-key

# ---------- Optional runtime path overrides (paths, not secrets; blank = bundled) ----------
# EIDOLON_EOT_MODEL_DIR=
# EIDOLON_FIRERED_PVAD_MODEL_DIR=
# EIDOLON_EOT_DEBUG_LOG=
