# Channel secrets and provider keys (copy to config/.env)
# Maps to empty placeholders in config/settings.yaml (core / llm / remote_agent_rpc)

LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

OPENAI_LLM_API_KEY=
OPENAI_LLM_BASE_URL=
OPENAI_LLM_MODEL=gpt-4o-mini

STT_PROVIDER=sensetime
TTS_PROVIDER=sensetime
VAD_PROVIDER=firered

# Plugin-specific keys (not in settings.yaml): SENSETIME_STT_API_KEY, DASHSCOPE_API_KEY, etc.
# See deploy/livekit-channel.env.template for the full list.
